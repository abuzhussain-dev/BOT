# ---- Server / bot identity ----
BOT_USERNAME=BOTC
BOT_PASSWORD=change_me

SERVER_HOST=RUIN_SMPS1.aternos.me
SERVER_PORT=56892

# Set to the server's reported Minecraft version, e.g. 1.21.1 / 1.21.4
MINECRAFT_VERSION=1.21.1

# 'offline' works with Aternos when online-mode is off.
# 'mojang' / 'microsooft' require real credentials.
AUTH_MODE=offline

# ---- Reconnect ----
RECONNECT=true
RECONNECT_DELAY_SEC=15

# ---- Chat command prefix (human control via in-game chat) ----
CHAT_PREFIX=/bot

# ---- AI / LLM (OpenAI-compatible chat completions API) ----
# Uncomment to enable the LLM brain. Without it the bot uses the
# built-in heuristic planner so it can still grind on its own.
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_API_KEY=
#LLM_MODEL=deepseek-v4-flash-free
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SEC=60

# ---- Behaviour ----
# How often (seconds) the brain wakes up to plan the next action.
PLAN_INTERVAL_SEC=8
# Health below which the bot stops work and tries to eat / wait.
SAFE_HEALTH=16
# Security margin for egg-ball (fallback eat threshold)
FOOD_THRESHOLD=12